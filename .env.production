# Database URLs (Connection Pooling for Production)
# DATABASE_URL=<set-in-deployment-env>
# DIRECT_URL=<set-in-deployment-env>

# Voice Configuration - Voice-First Approach
VOICE_STT_PROVIDER=openai-whisper
VOICE_TTS_PROVIDER=openai-tts
VOICE_STT_MODEL=whisper-1
VOICE_TTS_MODEL=tts-1-hd
VOICE_TTS_VOICE_AR=shimmer  # Best for Arabic/Darija
VOICE_TTS_VOICE_FR=nova     # Clear French pronunciation
VOICE_AUTO_DETECT_LANGUAGE=true
VOICE_ENABLE_PLAYBACK=true
VOICE_ENABLE_PREVIEW=true

# Security Headers
CONTENT_SECURITY_POLICY="default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://apis.google.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' https://api.mo7ami.ai https://*.supabase.co https://api.openai.com"

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=600

# Monitoring & Analytics
# NEXT_PUBLIC_GA_ID=<set-in-deployment-env>
# SENTRY_DSN=<set-in-deployment-env>

# Feature Flags
ENABLE_VOICE_FIRST=true
ENABLE_RECORDING_PLAYBACK=true
ENABLE_VOICE_MODAL_IMPROVEMENTS=true
ENABLE_HAPTIC_FEEDBACK=true